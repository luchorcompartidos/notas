rules_version = '2';

// Reglas de seguridad de Firestore para ANote (v0.4.0: administración de usuarios; v0.3.0: inicio con correo
// y contraseña propia; v0.1.0: notas compartidas, imágenes aparte, historial y pedidos de acceso).
// Se pegan en Firebase → Firestore Database → Reglas → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    // Marca de "solo contraseña propia de ANote" (security/{uid}). Si está puesta, se rechaza cualquier
    // sesión iniciada con Google (por ejemplo, la de otro dispositivo que quedó abierta).
    function securityDoc() {
      return /databases/$(database)/documents/security/$(request.auth.uid);
    }

    function blockedGoogle() {
      return request.auth.token.firebase.sign_in_provider == 'google.com'
        && exists(securityDoc())
        && get(securityDoc()).data.get('passwordOnly', false) == true;
    }

    function signedIn() {
      return request.auth != null && !blockedGoogle();
    }

    // Correo verificado: las invitaciones se otorgan por correo, así que sin verificarlo alguien podría
    // registrarse con un correo ajeno y ver lo que le compartieron a otro.
    function emailOk() {
      return request.auth.token.get('email_verified', false) == true
        || request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    function isMember(data) {
      return signedIn() && request.auth.uid in data.memberIds;
    }

    function isOwner(data) {
      return signedIn() && data.owner == request.auth.uid;
    }

    // Dueño, o miembro con permiso de edición
    function canEdit(data) {
      return isOwner(data)
        || (isMember(data) && data.get('roles', {}).get(request.auth.uid, 'edit') == 'edit');
    }

    function noteData(noteId) {
      return get(/databases/$(database)/documents/notes/$(noteId)).data;
    }

    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function inviteFor(noteId) {
      return /databases/$(database)/documents/invites/$(noteId + '_' + myEmail());
    }

    // Resumen de la nota (contenido compartido). Solo lo ven sus miembros.
    match /notes/{noteId} {
      allow read: if isMember(resource.data);

      // Al crearla, el dueño es quien la crea y es el único miembro.
      allow create: if signedIn()
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid];

      allow update: if
        // El dueño: todo menos cambiar de dueño
        (isOwner(resource.data) && request.resource.data.owner == resource.data.owner)
        // Quien puede editar: el contenido, no los miembros ni los permisos
        || (canEdit(resource.data) && !changed().hasAny(['owner', 'memberIds', 'roles', 'members']))
        // Un miembro que sale de la nota
        || (isMember(resource.data)
            && changed().hasOnly(['memberIds', 'roles', 'members'])
            && request.resource.data.memberIds == resource.data.memberIds.removeAll([request.auth.uid]))
        // Quien acepta una invitación: se agrega a sí mismo con el permiso de la invitación
        || (signedIn()
            && emailOk()
            && !(request.auth.uid in resource.data.memberIds)
            && exists(inviteFor(noteId))
            && changed().hasOnly(['memberIds', 'roles', 'members'])
            && request.resource.data.memberIds == resource.data.memberIds.concat([request.auth.uid])
            && request.resource.data.roles.diff(resource.data.get('roles', {})).affectedKeys().hasOnly([request.auth.uid])
            && request.resource.data.roles[request.auth.uid] == get(inviteFor(noteId)).data.role);

      // Solo el dueño puede borrarla del todo.
      allow delete: if isOwner(resource.data);

      // Imágenes de la nota, guardadas aparte, y su historial de versiones.
      match /images/{imageId} {
        allow read: if isMember(noteData(noteId));
        allow create: if canEdit(noteData(noteId)) && request.resource.data.by == request.auth.uid;
        allow delete: if canEdit(noteData(noteId));
        allow update: if false;
      }
      match /versions/{versionId} {
        allow read: if isMember(noteData(noteId));
        allow create: if canEdit(noteData(noteId)) && request.resource.data.by == request.auth.uid;
        allow delete: if canEdit(noteData(noteId));
        allow update: if false;
      }

      // Cambios de Yjs (el contenido de la nota).
      match /updates/{updateId} {
        allow read: if isMember(noteData(noteId));
        allow create: if canEdit(noteData(noteId)) && request.resource.data.by == request.auth.uid;
        allow delete: if canEdit(noteData(noteId));
        allow update: if false;
      }
    }

    // Invitaciones para compartir: el id es "<idDeLaNota>_<email>"
    match /invites/{inviteId} {
      allow read: if signedIn() && ((emailOk() && resource.data.email == myEmail()) || resource.data.from == request.auth.uid);
      allow create, update: if signedIn()
        && request.resource.data.from == request.auth.uid
        && noteData(request.resource.data.noteId).owner == request.auth.uid
        && inviteId == request.resource.data.noteId + '_' + request.resource.data.email
        && request.resource.data.role in ['edit', 'view'];
      allow delete: if signedIn() && ((emailOk() && resource.data.email == myEmail()) || resource.data.from == request.auth.uid);
    }

    // Pedidos de acceso a una nota (desde un link): el id es "<idDeLaNota>_<uid>"
    match /accessRequests/{reqId} {
      allow create, update: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && reqId == request.resource.data.noteId + '_' + request.auth.uid
        && noteData(request.resource.data.noteId).owner == request.resource.data.owner;
      allow read, delete: if signedIn() && (resource.data.uid == request.auth.uid || resource.data.owner == request.auth.uid);
    }

    // Marca de seguridad de la cuenta. La lee el propio usuario (aun con una sesión de Google ya rechazada,
    // para que la app sepa que tiene que cerrarla). Solo se pone o se quita habiendo entrado con la
    // contraseña de ANote en los últimos 10 minutos.
    match /security/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.auth.token.auth_time > request.time.toMillis() / 1000 - 600
        && request.resource.data.keys().hasOnly(['passwordOnly', 'at'])
        && request.resource.data.passwordOnly is bool;
      allow delete: if request.auth != null && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.auth.token.auth_time > request.time.toMillis() / 1000 - 600;
    }

    // Administradores de ANote: el documento admins/{uid} se crea a mano en la consola de Firebase
    // (Firestore Database → Iniciar colección «admins» → ID del documento = UID del usuario). Desde la app no
    // se puede crear ni cambiar.
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Directorio de usuarios (v0.4.0): cada uno escribe su ficha al abrir ANote; la lee el administrador.
    match /directory/{uid} {
      allow read: if (request.auth != null && request.auth.uid == uid) || isAdmin();
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'providers', 'passwordOnly', 'verified',
             'signedIn', 'created', 'platform', 'version', 'lastSeen'])
        && request.resource.data.email == request.auth.token.get('email', '')
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && request.resource.data.lastSeen == request.time;
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }

    // Pedidos del administrador para cada usuario (v0.4.0): cerrar la sesión en todos sus dispositivos
    // (revokedAt) y pasar a la contraseña propia (ask). Los lee el propio usuario (aun con una sesión de Google
    // ya rechazada) y el administrador; solo el administrador los escribe.
    match /control/{uid} {
      allow read: if (request.auth != null && request.auth.uid == uid) || isAdmin();
      allow create, update: if isAdmin() && uid != request.auth.uid
        && request.resource.data.keys().hasOnly(['by', 'at', 'revokedAt', 'ask'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.get('ask', 'suggest') in ['suggest', 'require'];
      allow delete: if isAdmin();
    }

    // Organización personal de cada usuario (color, carpetas, etiquetas, recordatorios, preferencias).
    match /users/{uid}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
  }
}
