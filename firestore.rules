rules_version = '2';

// Reglas de seguridad de Firestore para Notas.
// Se pegan en Firebase → Firestore Database → Reglas → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMember(data) {
      return signedIn() && request.auth.uid in data.memberIds;
    }

    function noteData(noteId) {
      return get(/databases/$(database)/documents/notes/$(noteId)).data;
    }

    // Resumen de la nota (contenido compartido). Solo lo ven sus miembros.
    match /notes/{noteId} {
      allow read: if isMember(resource.data);

      // Al crearla, el dueño es quien la crea y es el único miembro.
      allow create: if signedIn()
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid];

      // Los miembros pueden editar el resumen, pero no cambiar dueño ni miembros
      // (compartir llega en una versión posterior).
      allow update: if isMember(resource.data)
        && request.resource.data.owner == resource.data.owner
        && request.resource.data.memberIds == resource.data.memberIds;

      // Solo el dueño puede borrarla del todo.
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;

      // Cambios de Yjs (el contenido de la nota).
      match /updates/{updateId} {
        allow read, delete: if isMember(noteData(noteId));
        allow create: if isMember(noteData(noteId))
          && request.resource.data.by == request.auth.uid;
        allow update: if false;
      }
    }

    // Organización personal de cada usuario (color, fijada, papelera).
    match /users/{uid}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
  }
}
