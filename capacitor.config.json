{
  "appId": "io.github.luchorcompartidos.notas",
  "appName": "Notas",
  "webDir": "dist",
  "android": {
    "adjustMarginsForEdgeToEdge": "force"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 500,
      "launchAutoHide": false,
      "showSpinner": false,
      "backgroundColor": "#FEF7FF"
    },
    "Keyboard": {
      "resizeOnFullScreen": true
    },
    "FirebaseAuthentication": {
      "skipNativeAuth": true,
      "providers": [
        "google.com"
      ]
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_notas",
      "iconColor": "#6750A4"
    }
  }
}
